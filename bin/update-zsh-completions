#!/bin/zsh

set -euo pipefail

repo_root="${0:A:h:h}"
completion_dir="$repo_root/zsh/completions"

mkdir -p "$completion_dir"

generate_completion() {
  local target_path="$1"
  shift

  local tmp_path="${target_path}.tmp"
  if ! "$@" > "$tmp_path" 2>/dev/null; then
    rm -f -- "$tmp_path"
    print -u2 -r -- "failed generating ${target_path:t} (ran: $*)"
    return 0
  fi
  chmod 0644 "$tmp_path"
  mv "$tmp_path" "$target_path"
  print -r -- "generated ${target_path:t}"
}

manage_generated_completion() {
  local command_name="$1"
  local completion_name="$2"
  shift 2

  local target_path="$completion_dir/$completion_name"

  # Not every machine has every tool -- skip silently.
  if ! whence -p "$command_name" >/dev/null; then
    return 0
  fi

  generate_completion "$target_path" "$@"
}

# One tool per line: command to check, completion file, generator command.
generators=(
  'docker  _docker  docker completion zsh'
  'gh      _gh      gh completion -s zsh'
  'mise    _mise    mise completion zsh'
  'op      _op      op completion zsh'
)

for spec in $generators; do
  manage_generated_completion ${=spec}
done
